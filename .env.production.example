# .env.production.example — Production environment template for VPS
# Copy to .env on VPS: cp .env.production.example .env
# Fill in actual values, chmod 600 .env

# ══════════════════════════════════════════════════════════
# Database (shared-mysql container on VPS)
# ══════════════════════════════════════════════════════════
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=pipsnote
DB_USER=pipsnote_app
DB_PASSWORD=                    # Generate: openssl rand -base64 24

# Backup DB user (read-only)
MYSQL_BACKUP_PASSWORD=          # Generate: openssl rand -base64 24

# ══════════════════════════════════════════════════════════
# Redis (dedicated container, internal-only)
# ══════════════════════════════════════════════════════════
REDIS_HOST=pipsnote-redis
REDIS_PORT=6379
REDIS_PASSWORD=                 # Generate: openssl rand -base64 24

# ══════════════════════════════════════════════════════════
# Meilisearch (dedicated container, internal-only)
# ══════════════════════════════════════════════════════════
MEILI_HOST=http://pipsnote-meilisearch:7700
MEILI_MASTER_KEY=               # Generate: openssl rand -base64 32

# ══════════════════════════════════════════════════════════
# App Secrets
# ══════════════════════════════════════════════════════════
JWT_SECRET=                     # Generate: openssl rand -base64 32
IP_SALT=                        # Generate: openssl rand -hex 16 (NEVER rotate!)
ENCRYPTION_KEY=                 # Generate: openssl rand -base64 32 (rotate every 180d)

# ══════════════════════════════════════════════════════════
# Cloudflare R2 (Backup Storage)
# ══════════════════════════════════════════════════════════
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=pipsnote-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ══════════════════════════════════════════════════════════
# Backup Encryption
# ══════════════════════════════════════════════════════════
BACKUP_ENC_KEY=                 # Generate: openssl rand -base64 32

# ══════════════════════════════════════════════════════════
# Application Settings
# ══════════════════════════════════════════════════════════
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Dataseed (should be false in production)
SEED_DEMO_DATA=false

# ══════════════════════════════════════════════════════════
# Quick Generate Commands (run these on VPS)
# ══════════════════════════════════════════════════════════
# openssl rand -base64 24   # For DB_PASSWORD
# openssl rand -base64 24   # For MYSQL_BACKUP_PASSWORD
# openssl rand -base64 24   # For REDIS_PASSWORD
# openssl rand -base64 32   # For MEILI_MASTER_KEY
# openssl rand -base64 32   # For JWT_SECRET
# openssl rand -hex 16      # For IP_SALT
# openssl rand -base64 32   # For ENCRYPTION_KEY
# openssl rand -base64 32   # For BACKUP_ENC_KEY
