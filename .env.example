# .env.example — pipsnote production
# Copy thanh .env, dien gia tri that, chmod 600. KHONG BAO GIO commit .env that.

# ── Database (shared-mysql tren VPS, DB rieng "pipsnote") ──
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=pipsnote
DB_USER=pipsnote_app
DB_PASSWORD=

# Backup DB user (least privilege — chi SELECT/LOCK, dung boi scripts/backup-mysql.sh + db-changelog.sh)
MYSQL_BACKUP_PASSWORD=

# ── Redis (container rieng cua pipsnote, internal-only) ──
REDIS_HOST=pipsnote-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Meilisearch (container rieng cua pipsnote, internal-only) ──
MEILI_HOST=http://pipsnote-meilisearch:7700
MEILI_MASTER_KEY=

# ── App secrets ──
JWT_SECRET=
# IP_SALT: KHONG rotate — rotate = mat kha nang dedup click cu (xem spec §16.8)
IP_SALT=
# ENCRYPTION_KEY: rotate 180 ngay, can re-encrypt data khi doi (background job)
ENCRYPTION_KEY=

# ── Cloudflare R2 (backup offsite — thay Google Drive) ──
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=pipsnote-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Cloudflare R2 (media — bucket rieng cho anh upload trong bai viet, tach khoi backup) ──
R2_MEDIA_BUCKET=pipsnote-media
# Public URL base (custom domain hoac r2.dev public access) de build link <img src>
R2_MEDIA_PUBLIC_URL=https://media.pipsnote.example.com

# ── Backup encryption (openssl aes-256-cbc -pbkdf2, xem scripts/backup-mysql.sh) ──
BACKUP_ENC_KEY=

# ── Market data providers (Ticker strip, xem lib/marketData/) ──
# Cac bien nay la FALLBACK: superadmin co the nhap/doi key truc tiep tai /admin/market-data
# (luu ma hoa trong bang market_data_provider_config, xem lib/marketData/providerConfig.ts).
# Key nhap qua UI se uu tien hon bien env; khong nhap gi qua UI -> app doc tu day nhu cu.
TWELVEDATA_API_KEY=
FCSAPI_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
# CoinGecko va Gold-API.com khong can API key
# MARKET_DATA_CRON_SECRET: header x-internal-secret cho app/api/internal/market-data/refresh (trigger thu cong/ben ngoai), KHONG dung admin cookie auth. Refresh dinh ky moi 15 phut chay bang node-cron trong process (lib/marketData/scheduler.ts), khong can bien nay.
MARKET_DATA_CRON_SECRET=
# MARKET_DATA_MOCK: true = dung du lieu gia lap, khong goi provider that (test local mien phi)
MARKET_DATA_MOCK=false

# ── AI translation (dich bai viet sang locale khac, xem lib/ai/translate.ts) ──
ANTHROPIC_API_KEY=
# Optional, chi dung cho scripts/translate-ui-messages.mjs (dich messages/*.json 1 lan, khong dung o production runtime).
# Script tu chon provider theo key nao co san: GEMINI_API_KEY > OPENROUTER_API_KEY.
# Model lay theo GEMINI_MODEL / OPENROUTER_MODEL (tu cau hinh, khong hardcode co dinh).
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Dataseed control (xem db/dataseed/README.md) ──
# SEED_DEMO_DATA: Chi chay db/dataseed/*.sql khi = true (staging/dev only)
# Production: set = false hoac bo qua (default = false)
SEED_DEMO_DATA=false

# ── Rotation reminder (xem spec §16.8, khong tu dong — nhac thu cong) ──
# JWT_SECRET          -> 90 ngay
# MySQL app password  -> 90 ngay
# MEILI_MASTER_KEY     -> 180 ngay
# SSH deploy key       -> 6 thang
