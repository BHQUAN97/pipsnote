# .env.example — pipsnote production
# Copy thanh .env, dien gia tri that, chmod 600. KHONG BAO GIO commit .env that.

# ── Database (shared-mysql tren VPS, DB rieng "pipsnote") ──
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=pipsnote
DB_USER=pipsnote_app
DB_PASSWORD=

# Backup DB user (least privilege — chi SELECT/LOCK, dung boi scripts/backup-mysql.sh + db-changelog.sh)
MYSQL_BACKUP_PASSWORD=

# ── Redis (container rieng cua pipsnote, internal-only) ──
REDIS_HOST=pipsnote-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Meilisearch (container rieng cua pipsnote, internal-only) ──
MEILI_HOST=http://pipsnote-meilisearch:7700
MEILI_MASTER_KEY=

# ── App secrets ──
JWT_SECRET=
# IP_SALT: KHONG rotate — rotate = mat kha nang dedup click cu (xem spec §16.8)
IP_SALT=
# ENCRYPTION_KEY: rotate 180 ngay, can re-encrypt data khi doi (background job)
ENCRYPTION_KEY=

# ── Cloudflare R2 (backup offsite — thay Google Drive) ──
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=pipsnote-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Backup encryption (openssl aes-256-cbc -pbkdf2, xem scripts/backup-mysql.sh) ──
BACKUP_ENC_KEY=

# ── Dataseed control (xem db/dataseed/README.md) ──
# SEED_DEMO_DATA: Chi chay db/dataseed/*.sql khi = true (staging/dev only)
# Production: set = false hoac bo qua (default = false)
SEED_DEMO_DATA=false

# ── Rotation reminder (xem spec §16.8, khong tu dong — nhac thu cong) ──
# JWT_SECRET          -> 90 ngay
# MySQL app password  -> 90 ngay
# MEILI_MASTER_KEY     -> 180 ngay
# SSH deploy key       -> 6 thang
